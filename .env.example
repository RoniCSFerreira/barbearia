# ─────────────────────────────────────────────
# Banco de Dados
# ─────────────────────────────────────────────

# Supabase (recomendado):
# Vá em: Project Settings → Database → Connection String → URI (Transaction pooler)
# DATABASE_URL="postgresql://postgres.xxxx:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Neon (alternativa):
# DATABASE_URL="postgresql://neondb_owner:[SENHA]@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# DIRECT_URL é usado pelo Prisma Migrate (bypass do pooler)
# Supabase: use Session pooler (porta 5432) ou conexão direta
# DIRECT_URL="postgresql://postgres.xxxx:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# ─────────────────────────────────────────────
# Next.js / Auth (para uso futuro)
# ─────────────────────────────────────────────

# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
